# ── Скопируйте в .env и поменяйте секреты ───────────────────────────────
#   cp .env.example .env
#   sed -i "s/CHANGE_ME_SECRET/$(openssl rand -hex 32)/" .env
# Комментарии держим на отдельных строках: значение читается до конца строки.

# ── База данных ─────────────────────────────────────────────────────────
POSTGRES_DB=au_queue
POSTGRES_USER=au_queue
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Ключ подписи сессий и токенов записи (openssl rand -hex 32) ─────────
SECRET_KEY=CHANGE_ME_SECRET

# ── Админ-панель: /admin ────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Кто принимает ───────────────────────────────────────────────────────
# Значение с решёткой берём в кавычки, иначе оно уедет в комментарий.
TEACHER_NAME="#au_team"
TEACHER_TITLE=Приём
SITE_TITLE=Живая очередь

# ── Часовой пояс ────────────────────────────────────────────────────────
TZ=Europe/Moscow

# ── Куда публикуем (за вашим внешним nginx) ────────────────────────────
BIND_ADDR=0.0.0.0
BIND_PORT=8080

# ── Живая очередь ───────────────────────────────────────────────────────
# кабинет, который подставляется при открытии приёма
ROOM=1215
# как часто страница очереди сама подтягивает свежий список, секунд
POLL_SECONDS=15
# внешний адрес для QR-кода: пусто — берётся из запроса,
# за прокси с непрозрачным именем пропишите явно, например https://queue.example.ru
PUBLIC_URL=

# ── Капча ───────────────────────────────────────────────────────────────
# сколько живёт выданное задание, секунд
CAPTCHA_TTL_SECONDS=600
# После любого неверного ответа автоматически выдаётся задание другого типа.

# ── Формат номера группы: КТ-24-04, АИ-23-04, КС-23-04 ─────────────────
# Для другого GROUP_PATTERN маска отключается: свободный ввод, проверка сервером.
GROUP_PATTERN=^[А-ЯЁ]{2}-[0-9]{2}-[0-9]{2}$
GROUP_PLACEHOLDER=КТ-24-04

# ── Куки только по HTTPS: 1 включать после настройки сертификата ───────
COOKIE_SECURE=0

# ── Зеркало реестра образов (если Docker Hub недоступен) ───────────────
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
