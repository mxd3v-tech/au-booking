# ── Скопируйте в .env и поменяйте секреты ───────────────────────────────
#   cp .env.example .env
#   sed -i "s/CHANGE_ME_SECRET/$(openssl rand -hex 32)/" .env
# Комментарии держим на отдельных строках: значение читается до конца строки.

# ── База данных ─────────────────────────────────────────────────────────
POSTGRES_DB=au_queue
POSTGRES_USER=au_queue
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Ключ подписи сессий и токенов отмены (openssl rand -hex 32) ─────────
SECRET_KEY=CHANGE_ME_SECRET

# ── Админ-панель: /admin ────────────────────────────────────────────────
ADMIN_USERNAME=uymin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Кто принимает ───────────────────────────────────────────────────────
TEACHER_NAME=Уймин Антон Григорьевич
TEACHER_TITLE=Преподаватель
SITE_TITLE=Запись на приём

# ── Часовой пояс ────────────────────────────────────────────────────────
TZ=Asia/Yekaterinburg

# ── Куда публикуем (за вашим внешним nginx) ────────────────────────────
BIND_ADDR=0.0.0.0
BIND_PORT=8080

# ── Правила записи («мягкие») ──────────────────────────────────────────
# запись на слот закрывается за N минут до его начала
BOOKING_LEAD_MINUTES=5
# активных броней на одного студента
MAX_ACTIVE_BOOKINGS=1
# на сколько дней вперёд показывать расписание
DAYS_AHEAD=30

# ── Капча ───────────────────────────────────────────────────────────────
# сколько живёт выданное задание, секунд
CAPTCHA_TTL_SECONDS=600
# попыток на одно задание, потом выдаётся новое
CAPTCHA_MAX_ATTEMPTS=4

# ── Формат номера группы: КТ-24-04, АИ-23-04, КС-23-04 ─────────────────
GROUP_PATTERN=^[А-ЯЁ]{2}-[0-9]{2}-[0-9]{2}$
GROUP_PLACEHOLDER=КТ-24-04

# ── Зеркало реестра образов ─────────────────────────────────────────────
# Раскомментируйте, если Docker Hub недоступен (403 при pull):
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim

# ── Куки ────────────────────────────────────────────────────────────────
# 1 — только при работе за HTTPS (см. deploy/nginx/).
# По http с этим флагом браузер куку не отправит и вход в админку не сработает.
COOKIE_SECURE=0
